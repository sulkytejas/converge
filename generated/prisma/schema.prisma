generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model application {
  id                 Int                            @id @default(autoincrement())
  status             Int                            @default(0) @db.TinyInt
  submitted_at       DateTime?                      @db.Timestamp(0)
  decided_at         DateTime?                      @db.Timestamp(0)
  created_at         DateTime                       @default(now()) @db.Timestamp(0)
  updated_at         DateTime                       @default(now()) @db.Timestamp(0)
  notes              String?                        @db.VarChar(1000)
  student_id         Int
  course_id          Int
  org_id             Int
  offer_letter_url   String?                        @db.VarChar(255)
  program_start_date DateTime?                      @db.Date
  // University-issued application / student reference (profile page capture).
  university_app_id  String?                        @db.VarChar(100)
  // Counsellor's vendor pick (Direct / third party). Free text until the
  // commissions vendor module gives vendors a table of their own.
  counsellor_vendor  String?                        @db.VarChar(100)
  // Documents requested with a conditional offer (array of strings).
  conditional_docs   Json?
  deposit_deadline   DateTime?                      @db.Date
  deposit_amount     Decimal?                       @db.Decimal(12, 2)
  deposit_currency   String?                        @db.Char(3)
  course             course                         @relation(fields: [course_id], references: [id], map: "fk_application_course")
  organization       organization                   @relation(fields: [org_id], references: [id], map: "fk_application_organization")
  student            student                        @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_application_student")
  commission         commission?
  stage_history      application_stage_history[]
  portal_credential  application_portal_credential?

  @@index([course_id], map: "fk_application_course1_idx")
  @@index([org_id], map: "fk_application_organization1_idx")
  @@index([student_id], map: "fk_application_student1_idx")
}

// The student's login for the university's own application portal, kept so
// any counsellor can pick up the case. Password is AES-256-GCM encrypted
// (src/server/crypto.ts) — never plaintext; reads are audit-logged.
model application_portal_credential {
  id             Int         @id @default(autoincrement())
  application_id Int         @unique(map: "uq_portal_credential_application")
  username       String      @db.VarChar(255)
  password_enc   String      @db.VarChar(1024)
  created_at     DateTime    @default(now()) @db.Timestamp(0)
  updated_at     DateTime    @default(now()) @updatedAt @db.Timestamp(0)
  application    application @relation(fields: [application_id], references: [id], onDelete: Cascade, map: "fk_portal_credential_application")
}

// One row per happy-path stage an application has reached (stage = the
// 0–7 UniApplicationStatus ordinals). Powers the dates under the profile
// page's pipeline stepper, and preserves the stage position when the
// status column holds a terminal outcome (>= 20).
model application_stage_history {
  id             Int         @id @default(autoincrement())
  application_id Int
  stage          Int         @db.UnsignedTinyInt
  occurred_at    DateTime    @default(now()) @db.Timestamp(0)
  application    application @relation(fields: [application_id], references: [id], onDelete: Cascade, map: "fk_stage_history_application")

  @@unique([application_id, stage], map: "uq_stage_history_app_stage")
}

model audit_log {
  id           Int           @id @default(autoincrement())
  org_id       Int?
  user_id      Int?
  action       String        @db.VarChar(100)
  entity_type  String?       @db.VarChar(50)
  entity_id    Int?
  metadata     Json?
  created_at   DateTime      @default(now()) @db.Timestamp(0)
  organization organization? @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_organization1")
  user         user?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_user1")

  @@index([org_id], map: "fk_audit_log_organization1_idx")
  @@index([user_id], map: "fk_audit_log_user1_idx")
}

model commission {
  id                      Int           @id @default(autoincrement())
  tuition_fee             Decimal       @db.Decimal(12, 2)
  currency                String        @db.Char(3)
  commision_rate          Decimal       @db.Decimal(5, 2)
  commision_amount        Decimal       @db.Decimal(12, 2)
  invoice_status          Int           @default(0) @db.UnsignedTinyInt
  paid_to_collegepond     Int           @default(0) @db.TinyInt
  paid_to_partner         Int           @default(0) @db.TinyInt
  partner_paid_at         DateTime?     @db.Timestamp(0)
  created_at              DateTime      @default(now()) @db.Timestamp(0)
  updated_at              DateTime      @default(now()) @db.Timestamp(0)
  application_id          Int           @unique(map: "application_id_UNIQUE")
  org_id                  Int
  collegepond_received_at DateTime?     @db.Timestamp(0)
  application             application   @relation(fields: [application_id], references: [id], onDelete: Cascade, map: "fk_commission_application")
  organization            organization  @relation(fields: [org_id], references: [id], map: "fk_commission_organization")
  invoice_item            invoice_item?

  @@index([application_id], map: "fk_commission_application1_idx")
  @@index([org_id], map: "fk_commission_organization1_idx")
}

model course {
  id                           Int           @id @default(autoincrement())
  name                         String        @db.VarChar(150)
  degree_level                 Int?          @db.UnsignedTinyInt
  duration_months              Int?          @db.SmallInt
  tuition_fee                  Decimal?      @db.Decimal(12, 2)
  currency                     String?       @db.Char(3)
  is_open                      Int           @default(1) @db.TinyInt
  created_at                   DateTime      @default(now()) @db.Timestamp(0)
  updated_at                   DateTime      @default(now()) @db.Timestamp(0)
  university_id                Int
  code                         String?       @unique(map: "code_UNIQUE") @db.VarChar(50)
  url                          String?       @db.VarChar(500)
  toefl                        Decimal?      @db.Decimal(5, 2)
  ielts                        Decimal?      @db.Decimal(3, 1)
  det                          Int?          @db.UnsignedSmallInt
  is_stem                      Int           @default(0) @db.TinyInt
  intake_month                 String?       @db.VarChar(50)
  intake_year                  Int?          @db.UnsignedSmallInt
  is_coop_available            Int           @default(0) @db.TinyInt
  has_app_fee_waiver           Int           @default(0) @db.TinyInt
  app_fee                      Decimal?      @db.Decimal(10, 2)
  has_tuition_deposit          Int           @default(0) @db.TinyInt
  has_scholarship              Int           @default(0) @db.TinyInt
  scholarship_amount           Decimal?      @db.Decimal(12, 2)
  min_entry_requirements       String?       @db.VarChar(50)
  min_entry_requirements_scale String?       @db.VarChar(20)
  has_faster_tat               Int           @default(0) @db.TinyInt
  application                  application[]
  shortlist                    shortlist[]
  university                   university    @relation(fields: [university_id], references: [id], map: "fk_course_university")

  @@index([university_id], map: "fk_course_university1_idx")
}

model document {
  id              Int           @id @default(autoincrement())
  file_name       String        @db.VarChar(255)
  file_url        String        @db.VarChar(500)
  mime_type       String?       @db.VarChar(100)
  is_most_recent  Int           @default(1) @db.TinyInt
  doc_type        String        @db.VarChar(50)
  status          Int           @default(0) @db.UnsignedTinyInt
  created_at      DateTime      @default(now()) @db.Timestamp(0)
  updated_at      DateTime      @default(now()) @db.Timestamp(0)
  org_id          Int?
  user_id         Int?
  is_org_document Int           @default(0) @db.TinyInt
  // Student-profile documents (SOP, LOR, offer letters, …) hang off the
  // student directly; org/user documents leave this NULL.
  student_id      Int?
  size_bytes      Int?
  description     String?       @db.VarChar(255)
  organization    organization? @relation(fields: [org_id], references: [id], onDelete: Restrict, map: "fk_document_organization")
  user            user?         @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_document_user")
  student         student?      @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_document_student")

  @@index([org_id], map: "fk_document_organization1_idx")
  @@index([user_id], map: "fk_document_user1_idx")
  @@index([student_id], map: "fk_document_student_idx")
}

model event {
  id                 Int                  @id @default(autoincrement())
  title              String               @db.VarChar(255)
  event_type         Int                  @db.UnsignedTinyInt
  description        String?              @db.VarChar(1000)
  event_date         DateTime             @db.Date
  start_time         DateTime?            @db.Time(0)
  end_time           DateTime?            @db.Time(0)
  timezone           String?              @db.VarChar(50)
  location           String?              @db.VarChar(255)
  is_virtual         Int                  @default(0) @db.TinyInt
  meeting_url        String?              @db.VarChar(500)
  max_attendees      Int?
  is_active          Int                  @default(1) @db.TinyInt
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  updated_at         DateTime             @default(now()) @db.Timestamp(0)
  event_registration event_registration[]
}

model event_registration {
  id             Int              @id @default(autoincrement())
  event_id       Int
  user_id        Int
  num_attendees  Int              @default(0) @db.UnsignedTinyInt
  status         Int              @default(0) @db.UnsignedTinyInt
  created_at     DateTime         @default(now()) @db.Timestamp(0)
  event          event            @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "fk_event_registration_event")
  user           user             @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_event_registration_user")
  event_reminder event_reminder[]

  @@index([event_id], map: "fk_event_registration_event1_idx")
  @@index([user_id], map: "fk_event_registration_user1_idx")
}

model event_reminder {
  id                    Int                @id @default(autoincrement())
  event_registration_id Int
  reminder_type         Int                @db.UnsignedTinyInt
  via_email             Int                @default(1) @db.TinyInt
  via_whatsapp          Int                @default(0) @db.TinyInt
  event_registration    event_registration @relation(fields: [event_registration_id], references: [id], onDelete: Cascade, map: "fk_event_reminder_event_registration")

  @@index([event_registration_id], map: "fk_event_reminder_event_registration1_idx")
}

model invoice {
  id                    Int            @id @default(autoincrement())
  invoice_number        String         @unique(map: "invoice_number_UNIQUE") @db.VarChar(30)
  invoice_date          DateTime       @db.Date
  total_amount          Decimal        @db.Decimal(14, 2)
  currency              String         @db.Char(3)
  status                Int            @default(0) @db.UnsignedTinyInt
  bank_details          String?        @db.VarChar(1000)
  notes                 String?        @db.VarChar(1000)
  signatory_name        String?        @db.VarChar(100)
  signatory_designation String?        @db.VarChar(100)
  created_at            DateTime       @default(now()) @db.Timestamp(0)
  updated_at            DateTime       @default(now()) @db.Timestamp(0)
  org_id                Int
  organization          organization   @relation(fields: [org_id], references: [id], map: "fk_invoice_organization")
  invoice_item          invoice_item[]

  @@index([org_id], map: "fk_invoice_organization1_idx")
}

model invoice_item {
  id            Int        @id @default(autoincrement())
  invoice_id    Int
  commission_id Int        @unique(map: "commission_id_UNIQUE")
  amount        Decimal    @db.Decimal(12, 2)
  created_at    DateTime   @default(now()) @db.Timestamp(0)
  commission    commission @relation(fields: [commission_id], references: [id], map: "fk_invoice_item_commission")
  invoice       invoice    @relation(fields: [invoice_id], references: [id], onDelete: Cascade, map: "fk_invoice_item_invoice")

  @@index([commission_id], map: "fk_invoice_item_commission1_idx")
  @@index([invoice_id], map: "fk_invoice_item_invoice1_idx")
}

model notification_preference {
  id                Int  @id @default(autoincrement())
  user_id           Int
  notification_type Int  @db.UnsignedTinyInt
  via_email         Int  @default(1) @db.TinyInt
  via_sms           Int  @default(0) @db.TinyInt
  user              user @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notification_preference_user")

  @@index([user_id], map: "fk_notification_preference_user1_idx")
}

model organization {
  id                    Int           @id @default(autoincrement())
  name                  String        @db.VarChar(100)
  type                  Int           @db.UnsignedTinyInt
  website               String?       @db.VarChar(255)
  address               String?       @db.VarChar(255)
  city                  String?       @db.VarChar(100)
  state                 String?       @db.VarChar(100)
  country               String?       @db.VarChar(2)
  num_counsellors       Int?          @db.UnsignedTinyInt
  is_verified           Int           @default(0) @db.TinyInt
  created_at            DateTime      @default(now()) @db.Timestamp(0)
  updated_at            DateTime      @default(now()) @db.Timestamp(0)
  annual_student_volume Int?          @db.UnsignedTinyInt
  url_identifier        String        @unique(map: "url_identifier_UNIQUE") @db.VarChar(100)
  logo_url              String?       @db.VarChar(255)
  gst_number            String?       @db.VarChar(20)
  application           application[]
  audit_log             audit_log[]
  commission            commission[]
  document              document[]
  invoice               invoice[]
  student               student[]
  user                  user[]
}

model session {
  id         Int      @id @default(autoincrement())
  token_hash String   @unique(map: "token_hash_UNIQUE") @db.VarChar(255)
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(500)
  expires_at DateTime @db.Timestamp(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  user_id    Int
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_session_user1")

  @@index([user_id], map: "fk_session_user1_idx")
}

model student {
  id                        Int                         @id @default(autoincrement())
  first_name                String                      @db.VarChar(50)
  last_name                 String                      @db.VarChar(50)
  email                     String?                     @db.VarChar(255)
  phone                     String?                     @db.VarChar(20)
  // Destination / country of interest (ISO2) — distinct from nationality.
  country                   String?                     @db.VarChar(2)
  intake                    String?                     @db.VarChar(20)
  created_at                DateTime                    @default(now()) @db.Timestamp(0)
  updated_at                DateTime                    @default(now()) @updatedAt @db.Timestamp(0)
  gender                    Int?                        @db.UnsignedTinyInt
  // Nullable so independent counsellors (user.org_id = NULL) can own students.
  org_id                    Int?
  counsellor_id             Int?
  date_of_birth             DateTime?                   @db.Date
  nationality               String?                     @db.VarChar(2)
  // 21-value pipeline status (see StudentStatus in src/server/db/enums.ts).
  status                    Int                         @default(0) @db.UnsignedTinyInt
  // 0 Foundation, 1 Diploma, 2 UG, 3 PG, 4 MBA, 5 PhD (CourseLevel enum).
  course_level              Int?                        @db.UnsignedTinyInt
  // Pre-application program of interest; once applications exist the displayed
  // program/university derive from the furthest-stage application.
  interested_program        String?                     @db.VarChar(100)
  education_loan            Int?                        @db.TinyInt
  apply_through_cp          Int?                        @db.TinyInt
  // CP-side assigned counsellor (admin "Assign" action). counsellor_id above
  // remains the partner-side counsellor used for partner-portal scoping.
  cp_counsellor_id          Int?
  // Partner user who created the record — scoping for org-less independents.
  created_by_user_id        Int?
  // ---- Profile-page personal information (cp-student-profile mock) ----
  middle_name               String?                     @db.VarChar(50)
  // 0 Single, 1 Married, 2 Divorced, 3 Widowed, 4 Prefer not to say.
  marital_status            Int?                        @db.UnsignedTinyInt
  // Addresses keep mock-style country names (postal addresses, not ISO2).
  mailing_address1          String?                     @db.VarChar(255)
  mailing_address2          String?                     @db.VarChar(255)
  mailing_city              String?                     @db.VarChar(100)
  mailing_state             String?                     @db.VarChar(100)
  mailing_country           String?                     @db.VarChar(50)
  mailing_postal            String?                     @db.VarChar(20)
  permanent_same_as_mailing Int                         @default(0) @db.TinyInt
  permanent_address1        String?                     @db.VarChar(255)
  permanent_address2        String?                     @db.VarChar(255)
  permanent_city            String?                     @db.VarChar(100)
  permanent_state           String?                     @db.VarChar(100)
  permanent_country         String?                     @db.VarChar(50)
  permanent_postal          String?                     @db.VarChar(20)
  dual_citizenship          Int?                        @db.TinyInt
  passport_number           String?                     @db.VarChar(20)
  passport_expiry           DateTime?                   @db.Date
  visa_refused              Int?                        @db.TinyInt
  visa_refused_details      String?                     @db.VarChar(500)
  criminal_record           Int?                        @db.TinyInt
  criminal_record_details   String?                     @db.VarChar(500)
  medical_condition         Int?                        @db.TinyInt
  medical_condition_details String?                     @db.VarChar(500)
  // 0 10th, 1 12th, 2 UG, 3 Masters/MBA, 4 PhD (EducationLevel enum).
  highest_education_level   Int?                        @db.UnsignedTinyInt
  application               application[]
  shortlist                 shortlist[]
  emergency_contact         student_emergency_contact[]
  education                 student_education[]
  work_experience           student_work_experience[]
  test_score                student_test_score[]
  note                      student_note[]
  document                  document[]
  organization              organization?               @relation(fields: [org_id], references: [id], map: "fk_student_organization")
  user                      user?                       @relation("student_counsellor", fields: [counsellor_id], references: [id], onUpdate: NoAction, map: "fk_student_user")
  cp_counsellor             collegepond_user?           @relation(fields: [cp_counsellor_id], references: [id], onDelete: SetNull, map: "fk_student_cp_counsellor")
  created_by                user?                       @relation("student_created_by", fields: [created_by_user_id], references: [id], onDelete: SetNull, map: "fk_student_created_by")

  @@index([org_id], map: "fk_student_organization1_idx")
  @@index([counsellor_id], map: "fk_student_user1_idx")
  @@index([status], map: "idx_student_status")
  @@index([cp_counsellor_id], map: "idx_student_cp_counsellor")
  @@index([created_by_user_id], map: "idx_student_created_by")
}

model university {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(150)
  code       String?  @unique(map: "uni_code_UNIQUE") @db.VarChar(50)
  city       String?  @db.VarChar(100)
  country    String   @db.VarChar(2)
  type       Int      @default(0) @db.TinyInt
  ranking    Int?     @db.UnsignedSmallInt
  app_source String?  @db.VarChar(50)
  website    String?  @db.VarChar(255)
  logo_url   String?  @db.VarChar(255)
  is_open    Int      @default(1) @db.TinyInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  course     course[]
}

model user {
  id                                                                      Int                       @id @default(autoincrement())
  first_name                                                              String                    @db.VarChar(50)
  last_name                                                               String                    @db.VarChar(50)
  type                                                                    Int                       @db.UnsignedTinyInt
  email                                                                   String                    @unique(map: "email_UNIQUE") @db.VarChar(255)
  phone                                                                   String                    @db.VarChar(45)
  is_owner                                                                Int                       @default(0) @db.TinyInt
  status                                                                  Int                       @default(0) @db.UnsignedTinyInt
  avatar_url                                                              String?                   @db.VarChar(500)
  is_email_verified                                                       Int                       @default(0) @db.TinyInt
  is_phone_verified                                                       Int                       @default(0) @db.TinyInt
  tracking_id                                                             String?                   @unique(map: "tracking_id_UNIQUE") @db.VarChar(50)
  org_id                                                                  Int?
  date_of_birth                                                           DateTime?                 @db.Date
  gender                                                                  Int?                      @db.UnsignedTinyInt
  nationality                                                             String?                   @db.VarChar(2)
  address                                                                 String?                   @db.VarChar(255)
  city                                                                    String?                   @db.VarChar(100)
  state                                                                   String?                   @db.VarChar(100)
  country                                                                 String?                   @db.VarChar(2)
  approved_by_collegepond_user_id                                         Int?
  lead_counsellor_id                                                      Int?
  counsellor_id                                                           Int?
  bdm_id                                                                  Int?
  notes                                                                   String?                   @db.VarChar(255)
  tier                                                                    Int                       @default(0) @db.UnsignedTinyInt
  mou_signed_at                                                           DateTime?                 @db.Timestamp(0)
  last_login_at                                                           DateTime?                 @db.Timestamp(0)
  created_at                                                              DateTime                  @default(now()) @db.Timestamp(0)
  updated_at                                                              DateTime                  @default(now()) @db.Timestamp(0)
  audit_log                                                               audit_log[]
  document                                                                document[]
  event_registration                                                      event_registration[]
  notification_preference                                                 notification_preference[]
  session                                                                 session[]
  student                                                                 student[]                 @relation("student_counsellor")
  student_created                                                         student[]                 @relation("student_created_by")
  collegepond_user_user_approved_by_collegepond_user_idTocollegepond_user collegepond_user?         @relation("user_approved_by_collegepond_user_idTocollegepond_user", fields: [approved_by_collegepond_user_id], references: [id], map: "fk_user_approved_by_collegepond_user")
  collegepond_user_user_bdm_idTocollegepond_user                          collegepond_user?         @relation("user_bdm_idTocollegepond_user", fields: [bdm_id], references: [id], map: "fk_user_bdm")
  collegepond_user_user_counsellor_idTocollegepond_user                   collegepond_user?         @relation("user_counsellor_idTocollegepond_user", fields: [counsellor_id], references: [id], map: "fk_user_counsellor")
  collegepond_user_user_lead_counsellor_idTocollegepond_user              collegepond_user?         @relation("user_lead_counsellor_idTocollegepond_user", fields: [lead_counsellor_id], references: [id], map: "fk_user_lead_counsellor")
  organization                                                            organization?             @relation(fields: [org_id], references: [id], onDelete: Cascade, map: "fk_user_organization")

  @@index([org_id], map: "fk_user_organization_idx")
  @@index([approved_by_collegepond_user_id], map: "fk_user_collegepond_user1_idx")
  @@index([lead_counsellor_id], map: "fk_user_collegepond_user1_idx1")
  @@index([counsellor_id], map: "fk_user_collegepond_user2_idx")
  @@index([bdm_id], map: "fk_user_collegepond_user_bdm_idx")
}

model collegepond_user {
  id                                                          Int                   @id @default(autoincrement())
  created_at                                                  DateTime              @default(now()) @db.Timestamp(0)
  updated_at                                                  DateTime              @default(now()) @db.Timestamp(0)
  first_name                                                  String                @db.VarChar(50)
  last_name                                                   String                @db.VarChar(50)
  email                                                       String                @unique(map: "email_UNIQUE") @db.VarChar(125)
  phone                                                       String                @db.VarChar(45)
  role                                                        Int                   @db.UnsignedTinyInt
  status                                                      Int                   @default(1) @db.UnsignedTinyInt
  last_login_at                                               DateTime?             @db.Timestamp(0)
  user_user_approved_by_collegepond_user_idTocollegepond_user user[]                @relation("user_approved_by_collegepond_user_idTocollegepond_user")
  user_user_bdm_idTocollegepond_user                          user[]                @relation("user_bdm_idTocollegepond_user")
  user_user_counsellor_idTocollegepond_user                   user[]                @relation("user_counsellor_idTocollegepond_user")
  user_user_lead_counsellor_idTocollegepond_user              user[]                @relation("user_lead_counsellor_idTocollegepond_user")
  uni_assist_template                                         uni_assist_template[]
  student                                                     student[]
  shortlist                                                   shortlist[]
  student_note                                                student_note[]
}

// Tasks & Notes tab — one row is either a note (is_task 0) or a task
// (is_task 1, with due date / priority / done). Converting between the two
// just flips is_task, mirroring the mock.
model student_note {
  id                  Int               @id @default(autoincrement())
  student_id          Int
  body                String            @db.VarChar(1000)
  is_task             Int               @default(0) @db.TinyInt
  due_date            DateTime?         @db.Date
  // 0 Low, 1 Medium, 2 High.
  priority            Int?              @db.UnsignedTinyInt
  is_done             Int               @default(0) @db.TinyInt
  created_at          DateTime          @default(now()) @db.Timestamp(0)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamp(0)
  collegepond_user_id Int?
  student             student           @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_note_student")
  collegepond_user    collegepond_user? @relation(fields: [collegepond_user_id], references: [id], onDelete: SetNull, map: "fk_note_cp_user")

  @@index([student_id], map: "fk_note_student_idx")
  @@index([collegepond_user_id], map: "fk_note_cp_user_idx")
}

// 0 Parent, 1 Sibling, 2 Spouse, 3 Friend, 4 Other.
model student_emergency_contact {
  id           Int     @id @default(autoincrement())
  student_id   Int
  relationship Int     @db.UnsignedTinyInt
  name         String  @db.VarChar(100)
  email        String? @db.VarChar(255)
  phone        String? @db.VarChar(45)
  student      student @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_emergency_contact_student")

  @@index([student_id], map: "fk_emergency_contact_student_idx")
}

// One row per education level (EducationLevel enum) — the profile page's
// Academic Qualification sections.
model student_education {
  id              Int     @id @default(autoincrement())
  student_id      Int
  level           Int     @db.UnsignedTinyInt
  country         String? @db.VarChar(50)
  board           String? @db.VarChar(100)
  state           String? @db.VarChar(50)
  qualification   String? @db.VarChar(100)
  institution     String? @db.VarChar(150)
  city            String? @db.VarChar(100)
  grading_system  String? @db.VarChar(20)
  scale           String? @db.VarChar(50)
  score           String? @db.VarChar(20)
  language        String? @db.VarChar(30)
  pass_month      Int?    @db.UnsignedTinyInt
  pass_year       Int?    @db.UnsignedSmallInt
  major           String? @db.VarChar(100)
  research_topic  String? @db.VarChar(255)
  predicted_score String? @db.VarChar(20)
  student         student @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_education_student")

  @@unique([student_id, level], map: "uq_education_student_level")
}

model student_work_experience {
  id                Int     @id @default(autoincrement())
  student_id        Int
  company           String  @db.VarChar(150)
  job_title         String? @db.VarChar(100)
  employment_type   String? @db.VarChar(20)
  industry          String? @db.VarChar(50)
  start_month       Int     @db.UnsignedTinyInt
  start_year        Int     @db.UnsignedSmallInt
  end_month         Int?    @db.UnsignedTinyInt
  end_year          Int?    @db.UnsignedSmallInt
  currently_working Int     @default(0) @db.TinyInt
  city              String? @db.VarChar(100)
  country           String? @db.VarChar(50)
  description       String? @db.VarChar(1000)
  student           student @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_work_experience_student")

  @@index([student_id], map: "fk_work_experience_student_idx")
}

// One row per test attempt; `test` is the mock's test key (GRE, GMAT,
// GMAT_Focus, SAT, ACT, IELTS, TOEFL, TOEFL2026, PTE, Duolingo) and
// `scores` holds that test's field map (e.g. {"verbal":165,"quant":168}).
model student_test_score {
  id         Int       @id @default(autoincrement())
  student_id Int
  test       String    @db.VarChar(20)
  attempt    Int       @db.UnsignedTinyInt
  scores     Json
  test_date  DateTime? @db.Date
  student    student   @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_test_score_student")

  @@unique([student_id, test, attempt], map: "uq_test_score_student_test_attempt")
}

// Uni Assist shortlists — courses an admin flagged for a student. Precursor
// to an application; replaces the old localStorage-only persistence.
model shortlist {
  id                  Int               @id @default(autoincrement())
  student_id          Int
  course_id           Int
  // Admin who shortlisted; kept for attribution, null if the account goes.
  collegepond_user_id Int?
  created_at          DateTime          @default(now()) @db.Timestamp(0)
  student             student           @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_shortlist_student")
  course              course            @relation(fields: [course_id], references: [id], onDelete: Cascade, map: "fk_shortlist_course")
  collegepond_user    collegepond_user? @relation(fields: [collegepond_user_id], references: [id], onDelete: SetNull, map: "fk_shortlist_cp_user")

  @@unique([student_id, course_id], map: "uq_shortlist_student_course")
  @@index([course_id], map: "fk_shortlist_course_idx")
  @@index([collegepond_user_id], map: "fk_shortlist_cp_user_idx")
}

// Saved Uni Assist filter sets. Team-wide: every admin can see and load any
// template; only the creator (or a super admin) can delete it.
model uni_assist_template {
  id                  Int              @id @default(autoincrement())
  name                String           @db.VarChar(100)
  filters             Json
  collegepond_user_id Int
  created_at          DateTime         @default(now()) @db.Timestamp(0)
  collegepond_user    collegepond_user @relation(fields: [collegepond_user_id], references: [id], onDelete: Cascade, map: "fk_uni_assist_template_cp_user")

  @@index([collegepond_user_id], map: "fk_uni_assist_template_cp_user_idx")
}
